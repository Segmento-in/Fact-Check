# Backend-only credentials: enter your keys after applying this update.
NEWSAPI_API_KEY=
NEWSDATA_API_KEY=

# All configured providers run alongside the free Feeds.
DEFAULT_FEED=all
ENABLED_FEEDS=["hackernews","medium","google_news","newsdata","newsapi"]
FEED_DEFAULT_LIMIT=60
FEED_MAX_LIMIT=100
NEWS_FEED_QUERY=technology
NEWS_FEED_LANGUAGE=en
NEWSDATA_COUNTRY=us
NEWSDATA_PAGE_SIZE=10
NEWSAPI_PAGE_SIZE=20
GOOGLE_NEWS_LANGUAGE=en-US
GOOGLE_NEWS_COUNTRY=US
GOOGLE_NEWS_EDITION=US:en

HN_TOP_STORIES_LIMIT=30
HN_MAX_LIMIT=100
HTTP_TIMEOUT_SECONDS=10.0
MAX_CONCURRENT_REQUESTS=10
MEDIUM_TAGS=["artificial-intelligence","technology","data-science","cybersecurity","programming","cloud-computing","law"]
CORS_ORIGINS=["http://localhost:3000"]
ARTICLE_FETCH_TIMEOUT_SECONDS=10.0
ARTICLE_MAX_DOWNLOAD_BYTES=2000000
ARTICLE_MIN_WORDS=100
ARTICLE_MAX_CHARS=20000
ARTICLE_USER_AGENT=FactCheckerBot/0.1 (proof of concept)
ARTICLES_MAX_CONCURRENT_EXTRACTIONS=5
ARTICLES_CACHE_TTL_SECONDS=600
